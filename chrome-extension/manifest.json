{
  "manifest_version": 3,
  "name": "Quick Saver — Jobs & Property Leads",
  "version": "1.4.0",
  "description": "Save jobs, property rows, or Facebook Group posts for review; optional upload to your Google Drive, Dropbox or OneDrive.",
  "key": "",
  "permissions": ["activeTab", "storage", "contextMenus", "downloads", "identity", "notifications", "scripting"],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://*.glassdoor.com/*",
    "https://*.remotive.com/*",
    "https://*.weworkremotely.com/*",
    "https://*.remoteok.com/*",
    "https://*.wellfound.com/*",
    "https://*.otta.com/*",
    "https://*.dice.com/*",
    "https://*.jobthai.com/*",
    "https://*.jobsdb.com/*",
    "https://www.googleapis.com/*",
    "https://api.dropboxapi.com/*",
    "https://content.dropboxapi.com/*",
    "https://graph.microsoft.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://*.glassdoor.com/*",
        "https://*.remotive.com/*",
        "https://*.weworkremotely.com/*",
        "https://*.remoteok.com/*",
        "https://*.wellfound.com/*",
        "https://*.otta.com/*",
        "https://*.dice.com/*",
        "https://*.jobthai.com/*",
        "https://*.jobsdb.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
