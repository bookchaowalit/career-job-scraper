{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facebook-group-post.v1",
  "schema_version": "facebook.group-post.v1",
  "title": "Facebook Group rendered post capture",
  "description": "A user-selected rendered Facebook Group post. Visibility is an operator-labelled gate; contact signals remain review-only evidence.",
  "type": "object",
  "x-privacy-class": "group_visible_content",
  "x-human-review-required": true,
  "x-source-boundary": "The extension reads only the currently rendered tab and never calls a Facebook API or fetches another URL.",
  "required": [
    "captured_at",
    "group_url",
    "post_url",
    "post_id",
    "group_name",
    "author_name",
    "posted_at",
    "text",
    "visibility",
    "text_complete",
    "capture_method",
    "source_channel",
    "source_platform",
    "contact_role",
    "co_agent_status",
    "contact_public",
    "lead_review_status",
    "review_decision",
    "outreach_status"
  ],
  "properties": {
    "captured_at": {"type": "string", "format": "date-time"},
    "group_url": {"type": "string", "format": "uri"},
    "post_url": {"type": "string", "format": "uri"},
    "post_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "group_name": {"type": "string", "maxLength": 240},
    "author_name": {"type": "string", "maxLength": 160},
    "posted_at": {"type": "string"},
    "text": {"type": "string", "maxLength": 10000},
    "visibility": {"type": "string", "enum": ["public", "private", "unknown"]},
    "text_complete": {"type": "boolean"},
    "capture_method": {"type": "string", "enum": ["chrome_extension_visible_tab", "chrome_extension_auto_scroll", "manual_browser_export", "playwright_visible_tab"]},
    "source_channel": {"type": "string", "const": "facebook_group"},
    "source_platform": {"type": "string", "const": "facebook"},
    "contact_name": {"type": "string"},
    "contact_role": {"type": "string", "enum": ["owner", "agent", "owner_or_agent", "unknown"]},
    "co_agent_status": {"type": "string", "enum": ["yes", "no", "unknown"]},
    "contact_phone": {"type": "string"},
    "contact_email": {"type": "string"},
    "contact_line": {"type": "string"},
    "contact_facebook": {"type": "string"},
    "contact_instagram": {"type": "string"},
    "contact_tiktok": {"type": "string"},
    "contact_social_urls": {"type": "string"},
    "contact_source_url": {"type": "string", "format": "uri"},
    "contact_evidence": {"type": "string", "maxLength": 320},
    "contact_confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "contact_public": {"type": "boolean"},
    "lead_review_status": {"type": "string", "enum": ["co_agent_candidate", "needs_human_review", "unqualified"]},
    "review_decision": {"type": "string", "enum": ["pending", "approved", "rejected", "needs_more_evidence"]},
    "reviewed_at": {"type": "string"},
    "reviewer_id": {"type": "string"},
    "outreach_status": {"type": "string", "enum": ["not_contacted", "approved_to_contact", "contacted", "opt_out"]},
    "retention_until": {"type": "string"},
    "terms_basis_ref": {"type": "string"}
  },
  "additionalProperties": false
}
